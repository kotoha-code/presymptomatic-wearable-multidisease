"""
01_cohort_matching.py
=====================
Matched case-control cohort construction for pre-symptomatic chronic
disease detection from wearable data in the All of Us Research Program.

Design
------
For each disease, cases (diagnosed participants with wearable data in the
prediction window) are matched 4:1 to disease-negative Fitbit users on:
    - sex (exact)
    - age (+/- 5 years at index date)
    - calendar time (control index date falls within the control's Fitbit
      wear period, so cases and controls are compared over the same era)

The case's diagnosis date is "borrowed" as the control's index date, which
also aligns calendar time (Fitbit data quality varies year to year).

BMI is NOT used as a matching variable (high missingness would shrink the
sample, especially for rare diseases such as schizophrenia); it is retained
as a predictor instead.

Prediction window: 548 to 180 days before diagnosis (18 to 6 months).

Requirements
------------
- All of Us Controlled Tier access (Researcher Workbench).
- No participant-level data is included in this repository. Paths and IDs
  are read at runtime from the environment / the researcher's own tables.
"""

import os
import random
import pandas as pd
import numpy as np

# --- Configuration -----------------------------------------------------------

CDR = os.environ["WORKSPACE_CDR"]  # All of Us Curated Data Repository (BigQuery)

# OMOP concept IDs for the four target diseases
CONCEPT_IDS = {
    "T2D":  201826,   # Type 2 diabetes mellitus
    "SCZ":  436073,   # Psychotic disorder (schizophrenia phenotype)
    "DEPR": 4152280,  # Major depressive disorder
    "CAD":  317576,   # Coronary artery disease
}

# Prediction window (days before diagnosis / index date)
WINDOW_START_DAYS = 548  # 18 months
WINDOW_END_DAYS = 180    # 6 months

MATCH_RATIO = 4          # controls per case
AGE_TOLERANCE = 5        # years
SEED = 42


# --- Matching ----------------------------------------------------------------

def build_matched_controls(disease, date_col, cases_with_features, master,
                           n_ratio=MATCH_RATIO, age_tol=AGE_TOLERANCE, seed=SEED):
    """Match disease-negative Fitbit users to cases.

    Parameters
    ----------
    disease : str
        Disease key (e.g. "T2D").
    date_col : str
        Column in `master` holding the diagnosis date (e.g. "T2D_date").
    cases_with_features : set[int]
        person_ids of cases that have wearable features in the window.
    master : pd.DataFrame
        Participant-level table with disease labels, birth_datetime,
        gender_concept_id, fitbit_days, first_day, last_day.

    Returns
    -------
    pd.DataFrame
        Matched controls with columns:
        person_id, index_date, matched_case, disease.
    """
    random.seed(seed)

    # Cases: diagnosed, with a diagnosis date, restricted to those with features
    cases = (
        master[master[disease] == 1]
        [["person_id", date_col, "birth_datetime", "gender_concept_id"]]
        .dropna(subset=[date_col])
        .copy()
    )
    cases[date_col] = pd.to_datetime(cases[date_col]).dt.tz_localize(None)
    cases["birth_datetime"] = pd.to_datetime(cases["birth_datetime"]).dt.tz_localize(None)
    cases["age_at_dx"] = (cases[date_col] - cases["birth_datetime"]).dt.days / 365.25
    cases = cases.rename(columns={date_col: "index_date"})
    cases = cases[cases["person_id"].isin(cases_with_features)]

    # Control pool: disease-negative Fitbit users
    ctrl_pool = (
        master[(master[disease] == 0) & (master["fitbit_days"] > 0)]
        [["person_id", "birth_datetime", "gender_concept_id", "first_day", "last_day"]]
        .copy()
    )
    ctrl_pool["birth_datetime"] = pd.to_datetime(ctrl_pool["birth_datetime"]).dt.tz_localize(None)
    ctrl_pool["first_day"] = pd.to_datetime(ctrl_pool["first_day"])
    ctrl_pool["last_day"] = pd.to_datetime(ctrl_pool["last_day"])

    matched = []
    used = set()  # each control is used at most once

    for _, case in cases.iterrows():
        idx = case["index_date"]
        cand = ctrl_pool[
            (ctrl_pool["gender_concept_id"] == case["gender_concept_id"]) &   # same sex
            (~ctrl_pool["person_id"].isin(used)) &                            # unused
            (ctrl_pool["first_day"] <= idx) &                                 # index within
            (ctrl_pool["last_day"] >= idx)                                    #   Fitbit period
        ].copy()
        if cand.empty:
            continue

        cand["age_at_idx"] = (idx - cand["birth_datetime"]).dt.days / 365.25
        cand = cand[(cand["age_at_idx"] - case["age_at_dx"]).abs() <= age_tol]
        if cand.empty:
            continue

        picked = cand.sample(n=min(n_ratio, len(cand)), random_state=seed)
        for _, c in picked.iterrows():
            matched.append({
                "person_id": c["person_id"],
                "index_date": idx,               # borrow the case's diagnosis date
                "matched_case": case["person_id"],
                "disease": disease,
            })
            used.add(c["person_id"])

    md = pd.DataFrame(matched)
    print(f"{disease}: matched cases {md['matched_case'].nunique()}, controls {len(md)}")
    return md


if __name__ == "__main__":
